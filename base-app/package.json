{
  "name": "project-controls-hub",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.5.0",
  "scripts": {
    "start": "nx serve hub",
    "build": "nx build hub",
    "test": "nx test hub",
    "e2e": "nx e2e hub-e2e",
    "api:export-openapi": "cd apps/api && uv run python scripts/export_openapi.py",
    "api-client:generate": "yarn api:export-openapi && openapi-typescript contracts/openapi.json -o libs/api-client/src/lib/schema.ts",
    "api:lint": "cd apps/api && uv run ruff check . && uv run ruff format --check . && uv run mypy app tests",
    "api:format": "cd apps/api && uv run ruff format ."
  },
  "dependencies": {
    "@angular/animations": "21.2.15",
    "@angular/cdk": "21.2.13",
    "@angular/common": "21.2.15",
