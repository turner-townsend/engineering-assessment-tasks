# Build context is the repo root (base-app/) so contracts/seed-data.json is available.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /srv

# App code + the shared seed contract (config.py resolves REPO_ROOT as /srv).
COPY apps/api /srv/apps/api
COPY contracts /srv/contracts

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir /srv/apps/api

WORKDIR /srv/apps/api
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
